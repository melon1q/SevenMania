include(FetchContent)
option(BMS_USE_TRACY "Experimental Tracy instrumentation" OFF)
option(BMS_USE_MIMALLOC "Experimental C++ new/delete allocator" OFF)
option(BMS_USE_ONETBB "Experimental bounded song-scan scheduler" OFF)
option(BMS_HYBRID_RENDERER "Retain the GPU backdrop and upload only CPU gameplay regions" ON)

add_library(bms_performance INTERFACE)
if(BMS_HYBRID_RENDERER)
    target_compile_definitions(bms_performance INTERFACE BMS_HYBRID_RENDERER)
endif()
if(BMS_USE_TRACY)
    set(TRACY_ENABLE ON CACHE BOOL "" FORCE)
    set(TRACY_ON_DEMAND ON CACHE BOOL "" FORCE)
    set(TRACY_ONLY_LOCALHOST ON CACHE BOOL "" FORCE)
    set(TRACY_NO_BROADCAST ON CACHE BOOL "" FORCE)
    set(TRACY_NO_SYSTEM_TRACING ON CACHE BOOL "" FORCE)
    set(TRACY_NO_SAMPLING ON CACHE BOOL "" FORCE)
    set(TRACY_STATIC ON CACHE BOOL "" FORCE)
    FetchContent_Declare(tracy
        URL https://codeload.github.com/wolfpld/tracy/zip/c556831ddc6fe26d2fce01c14c97205a9dad46d5
        URL_HASH SHA256=e1e5e85e7f8e03374cbecd7a2e9317a662b192a08ea7514ccddd819969f66e8f)
    FetchContent_MakeAvailable(tracy)
    target_link_libraries(bms_performance INTERFACE Tracy::TracyClient)
    target_compile_definitions(bms_performance INTERFACE BMS_USE_TRACY)
endif()
if(BMS_USE_MIMALLOC)
    enable_language(C)
    set(MI_OVERRIDE OFF CACHE BOOL "" FORCE)
    set(MI_BUILD_SHARED OFF CACHE BOOL "" FORCE)
    set(MI_BUILD_STATIC ON CACHE BOOL "" FORCE)
    set(MI_BUILD_OBJECT OFF CACHE BOOL "" FORCE)
    set(MI_BUILD_TESTS OFF CACHE BOOL "" FORCE)
    FetchContent_Declare(mimalloc
        URL https://codeload.github.com/microsoft/mimalloc/zip/00d07c4c15a04a4cb68d3aeeecbd8d6ae80bb0b7
        URL_HASH SHA256=47a3214e82250d5aacd5e5868c9c92e7cfa8e7e2c2d109bbb5438710a2278984)
    FetchContent_MakeAvailable(mimalloc)
    target_link_libraries(bms_performance INTERFACE mimalloc-static)
    target_compile_definitions(bms_performance INTERFACE BMS_USE_MIMALLOC)
endif()
if(BMS_USE_ONETBB)
    set(TBB_TEST OFF CACHE BOOL "" FORCE)
    set(TBB_STRICT OFF CACHE BOOL "" FORCE)
    set(TBBMALLOC_BUILD OFF CACHE BOOL "" FORCE)
    set(TBBMALLOC_PROXY_BUILD OFF CACHE BOOL "" FORCE)
    set(TBB_INSTALL OFF CACHE BOOL "" FORCE)
    FetchContent_Declare(onetbb
        URL https://codeload.github.com/uxlfoundation/oneTBB/zip/06ce6212da6710f4bb2d20a1904b018aa44069bf
        URL_HASH SHA256=aa044e29ee75c5fafa4f4852268fd8ac5a1efc2e9640c22da4a2df6ebca74912)
    FetchContent_MakeAvailable(onetbb)
    target_link_libraries(bms_performance INTERFACE TBB::tbb)
    target_compile_definitions(bms_performance INTERFACE BMS_USE_ONETBB)
endif()
# Apply equally to the player and its regression/benchmark executables.
link_libraries(bms_performance)

function(bms_finalize_performance)
    get_property(targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
        get_target_property(type ${target} TYPE)
        if(type STREQUAL "EXECUTABLE")
            if(BMS_USE_MIMALLOC)
                target_sources(${target} PRIVATE ${PROJECT_SOURCE_DIR}/src/ExperimentalAllocator.cpp)
            endif()
            if(BMS_USE_ONETBB)
                add_custom_command(TARGET ${target} POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different
                    $<TARGET_FILE:TBB::tbb> $<TARGET_FILE_DIR:${target}>)
            endif()
        endif()
    endforeach()
endfunction()
