/* SevenMania skin select screen. Laid out like beatoraja's: screens on the left, the preview with
   arrows in the middle, the skin's options below. Rows are filled and shown by SkinSelectScreen.inl. */
head, title, link, style, script { display: none; }
body { margin: 0; width: 100%; height: 100%; background-color: #000000; color: #e8e8e5; font-family: Bms UI; font-size: 16px; }
div { display: block; }
#shell { display: flex; flex-direction: row; width: 100%; height: 100%; }
#screens { width: 23%; padding-top: 4%; }
.group { margin-bottom: 4%; }
.screen { height: 32px; line-height: 32px; padding-left: 14px; margin-bottom: 2px; font-size: 19px; letter-spacing: 1px; white-space: nowrap; overflow: hidden;
          background-color: #3a4a78; color: #b8d4e8; border-bottom: 2px #24305a; cursor: pointer; }
.screen:hover { background-color: #4a5c90; }
.screen.selected { background-color: #3e6f72; color: #ffffff; }
.screen.unsupported { background-color: #1e2438; color: #4e5670; cursor: auto; }
#main { flex: 1; padding: 1% 2% 0 6%; display: flex; flex-direction: column; }
#preview-row { display: flex; flex-direction: row; align-items: center; height: 52%; }
.arrow { width: 36px; text-align: center; font-size: 22px; color: #e8e8e5; cursor: pointer; }
.arrow:hover { color: #9fd0ff; }
#preview-box { flex: 1; height: 100%; background-color: #3a3a3a; display: flex; align-items: center; justify-content: center; overflow: hidden; }
#preview { max-width: 100%; max-height: 100%; }
#preview-note { position: absolute; color: #9aa2aa; font-size: 18px; }
#skin-name { text-align: center; font-size: 22px; margin-top: 10px; }
#skin-author { text-align: center; font-size: 14px; color: #8a929a; margin-bottom: 8px; }
#options { flex: 1; overflow-y: auto; padding-right: 10px; }
scrollbarvertical { width: 10px; }
scrollbarvertical slidertrack { background-color: #141414; }
scrollbarvertical sliderbar { width: 8px; min-height: 24px; background-color: #5a626a; border-radius: 3px; }
scrollbarvertical sliderbar:hover { background-color: #8a929a; }
.option { height: 44px; margin-bottom: 2px; }
.option-line { display: flex; flex-direction: row; align-items: center; height: 100%; }
.option.focused .value-box { background-color: #5a3324; }
.skin-row { margin-bottom: 8px; margin-right: 20px; }
.skin-row .value-box { background-color: #1e3a48; }
.skin-row.focused .value-box { background-color: #2c6a80; }
.label { width: 42%; text-align: left; font-size: 16px; white-space: nowrap; overflow: hidden; padding: 0 10px; }
.value-box { flex: 1; display: flex; flex-direction: row; align-items: center; height: 100%; background-color: #3a2018; }
.step { width: 40px; text-align: center; font-size: 18px; cursor: pointer; }
.step:hover { color: #ffcc88; }
.value { flex: 1; text-align: center; font-size: 18px; white-space: nowrap; overflow: hidden; }
#footer { height: 30px; line-height: 30px; font-size: 13px; color: #7a828a; text-align: right; padding-right: 16px; }
#status { color: #c8a060; }
