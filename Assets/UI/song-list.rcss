/* Sizes are 1920x1080 design units (dp); the host sets dp to the game window scale. */
body {
    margin: 0;
    width: 100%;
    height: 100%;
    background-color: transparent;
    font-family: "Bms UI";
    color: #232a33;
    font-size: 20dp;
}
#rows { position: absolute; width: 100%; height: 100%; overflow: hidden; }
#row-track { position: absolute; left: 0; right: 0; top: 0; }
#selection-guide { position: absolute; left: 4dp; right: 4dp; background-color: transparent; border-width: 0; }
.row {
    position: absolute;
    left: 20dp;
    right: 4dp;
    box-sizing: border-box;
    padding: 5dp 12dp 5dp 8dp;
    border: 1px #7c858f;
    border-radius: 0px;
    display: flex;
    align-items: center;
    background-color: #bcc2c9;
    decorator: none;
}
.row.alternate { background-color: #bcc2c9; decorator: none; }
.row.selected {
    left: 4dp;
    background-color: #dce2e8;
    decorator: none;
    border-color: #56a8c7;
    color: #151c24;
}
.lamp { width: 3dp; height: 70%; margin-right: 8dp; background-color: #687480; flex-shrink: 0; }
.lamp.clear { background-color: #4ade80; }
.lamp.played { background-color: #f87171; }
.level { font-family: Michroma; font-weight: normal; width: 55dp; text-align: center; font-size: 24dp; flex-shrink: 0; }
.labels { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-left: 10dp; }
.title { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 28dp; }
.title-text { display: block; width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; position: relative; }
.selected .title { text-overflow: clip; }
.selected .title-text { display: inline-block; overflow: visible; text-overflow: clip; }
.blocked .title { color: #68717b; }
.variant { font-size: 12dp; color: #485562; margin-left: 10dp; flex-shrink: 0; }
.banner { width: 128dp; height: 40dp; margin-left: 10dp; flex-shrink: 0; }
@media (max-width: 420px) {
    .banner { width: 96dp; height: 30dp; margin-left: 6dp; }
    .level { width: 42dp; }
    .labels { margin-left: 6dp; }
    .variant { margin-left: 4dp; font-size: 10dp; }
}
.empty { margin: 24dp 16dp; font-size: 18dp; color: #8fa8bd; }

/* Optional entry classes: old skin/package schemas need no new fields. */
.row.parent-folder, .row.parent-folder.alternate {
    background-color: #456780;
    decorator: none;
    border-top: 1px #8ba8ba;
    border-bottom: 1px #253b4e;
}
.row.parent-folder.selected {
    background-color: #527995;
    decorator: none;
    border-top: 1px #c3dfef;
    border-bottom: 1px #304d65;
}
.parent-folder .title, .parent-folder .level { color: #f2f6fa; }
.folder-entry .level, .all-songs .level { color: #394958; }
