<rml><head><title>스킨 선택</title><link type="text/rcss" href="skinselect.rcss" /></head><body>
<div id="shell">
<div id="screens">
<div class="group">
<div class="screen" id="screen-0">MUSIC SELECT</div>
<div class="screen" id="screen-1">DECIDE</div>
<div class="screen" id="screen-7">RESULT</div>
<div class="screen unsupported">COURSE RESULT</div>
<div class="screen unsupported">SOUND SET</div>
<div class="screen unsupported">KEY CONFIG</div>
<div class="screen unsupported">SKIN SELECT</div>
<div class="screen unsupported">THEME</div>
</div>
<div class="group">
<div class="screen" id="screen-2">7KEY</div>
<div class="screen unsupported">7KEY BATTLE</div>
<div class="screen" id="screen-4">14KEY</div>
<div class="screen" id="screen-3">5KEY</div>
<div class="screen unsupported">5KEY BATTLE</div>
<div class="screen" id="screen-5">10KEY</div>
<div class="screen" id="screen-6">9KEY</div>
