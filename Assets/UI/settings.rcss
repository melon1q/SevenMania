/* SevenMania settings — design tokens (RmlUi has no CSS variables; keep these values consistent)
   bg        #121314   sidebar   #0d0e0f   hover     #1b1d1f   line      #26292c
   control   #1f2225   control-line #343a3f
   text      #e8e8e5   muted     #7a828a   accent    #828c96   accent-text #0d0e0f  (accent = RGB 130,140,150)
   spacing 4 / 8 / 12 / 16 / 24     radius 3     font 13 / 15 / 20 */
head, title, link, style, script { display: none; }
body { margin: 0; width: 100%; height: 100%; background-color: #121314; color: #e8e8e5; font-family: Bms UI; font-size: 15px; }
div, h2, h3, label { display: block; }
h2, h3 { margin: 0; font-weight: normal; }
h2 { font-size: 20px; margin-bottom: 4px; }
h3 { font-size: 13px; color: #828c96; margin: 28px 0 4px; padding-bottom: 6px; border-bottom: 1px #26292c; letter-spacing: 1px; }
#settings-shell { display: flex; flex-direction: column; width: 100%; height: 100%; }
.workspace { display: flex; flex-grow: 1; flex-shrink: 1; flex-basis: 0px; height: 0px; min-height: 0; overflow: hidden; }
.sidebar { width: 140px; height: 100%; box-sizing: border-box; padding: 12px 0; background-color: #0d0e0f; flex-shrink: 0; overflow-y: auto; }
button { display: block; box-sizing: border-box; tab-index: auto; color: #e8e8e5; background-color: #1f2225; border: 1px #343a3f; border-radius: 3px; padding: 8px 14px; font-size: 14px; }
button:hover { background-color: #2a2e32; }
button:focus { border-color: #828c96; }
button:disabled { opacity: 0.4; }
.sidebar button { width: 100%; text-align: left; margin: 0; padding: 11px 20px; background-color: transparent; border: 0px; border-left: 3px transparent; border-radius: 0; color: #7a828a; font-size: 15px; }
.sidebar button:hover { background-color: #1b1d1f; color: #e8e8e5; }
.sidebar button:focus { border-left: 3px #828c96; }
.sidebar .active { border-left: 3px #828c96; background-color: #1b1d1f; color: #ffffff; }
.content { flex-grow: 1; min-width: 0; height: 100%; box-sizing: border-box; padding: 20px 28px 28px; overflow-y: auto; }

/* row: label column + control column */
.row { display: flex; align-items: center; min-height: 40px; padding: 3px 0; border-bottom: 1px #1d2023; }
.row > label, .row > .name { width: 190px; flex-shrink: 0; color: #e8e8e5; }
.ctl { display: flex; align-items: center; flex-grow: 1; min-width: 0; max-width: 340px; }
.hint { font-size: 13px; line-height: 1.5; color: #7a828a; margin: 6px 0 2px; }
.row .hint { margin: 0 0 0 16px; flex-grow: 1; min-width: 0; }
.actions { display: flex; flex-wrap: wrap; margin-top: 12px; }
.actions button { margin: 0 8px 8px 0; }

/* controls */
select { display: block; box-sizing: border-box; width: 100%; height: 32px; padding: 5px 10px; background-color: #1f2225; color: #e8e8e5; border: 1px #343a3f; border-radius: 3px; font-size: 14px; tab-index: auto; }
select:hover { border-color: #5a626a; }
select:focus { border-color: #828c96; }
input[type=text] { display: block; box-sizing: border-box; width: 100%; height: 32px; padding: 6px 10px; background-color: #1f2225; color: #e8e8e5; border: 1px #343a3f; border-radius: 3px; font-size: 14px; tab-index: auto; }
input[type=text]:hover { border-color: #5a626a; }
input[type=text]:focus { border-color: #828c96; }
select selectbox { max-height: 200px; overflow-y: auto; background-color: #1f2225; border: 1px #5a626a; z-index: 20; }
select option { display: block; padding: 6px 10px; }
select option:hover { background-color: #2a2e32; }
select option:checked { background-color: #828c96; color: #0d0e0f; }
select:disabled, input[type=checkbox]:disabled, input[type=range]:disabled { opacity: 0.4; }
input[type=range] { display: block; height: 24px; flex-grow: 1; min-width: 0; }
input[type=range] slidertrack { height: 4px; margin-top: 10px; background-color: #343a3f; border-radius: 2px; }
input[type=range] sliderbar { width: 12px; height: 20px; margin-top: -8px; background-color: #828c96; border-radius: 2px; }
.range-value { width: 64px; text-align: right; flex-shrink: 0; color: #e8e8e5; }
input[type=checkbox] { width: 22px; height: 22px; border: 2px #5a626a; background-color: #1f2225; border-radius: 3px; }
input[type=checkbox]:hover { border-color: #7a828a; }
input[type=checkbox]:checked { background-color: #828c96; border-color: #828c96; }
input[type=checkbox]:focus { border-color: #ffffff; }
#resource-state { margin-left: 12px; font-size: 13px; color: #7a828a; }

/* segmented choice (backed by a hidden select) and speed stepper */
.seg { display: flex; flex-grow: 1; }
.seg button { flex-grow: 1; margin: 0; padding: 6px 8px; text-align: center; border-radius: 0; border-left: 0px; background-color: #1f2225; color: #7a828a; }
.seg button:first-child { border-left: 1px #343a3f; border-radius: 3px 0px 0px 3px; }
.seg button:last-child { border-radius: 0px 3px 3px 0px; }
.seg button:hover { color: #e8e8e5; background-color: #2a2e32; }
.seg button.on { background-color: #828c96; border-color: #828c96; color: #0d0e0f; }
.seg button.disabled { opacity: 0.4; }
.stepper select { width: auto; flex-grow: 1; }
.step { flex-shrink: 0; width: 32px; margin-left: 6px; padding: 5px 0; text-align: center; }

/* compact grids (lane colours, lane separators) */
.grid { display: flex; flex-wrap: wrap; margin: 8px 0 0; }
.cell { width: 50%; box-sizing: border-box; padding: 0 12px 10px 0; }
.cell label { font-size: 13px; color: #7a828a; margin-bottom: 3px; }
.chips { display: flex; flex-wrap: wrap; margin-top: 8px; }
.chip { display: flex; align-items: center; margin: 0 14px 6px 0; font-size: 13px; color: #7a828a; }
.chip input { margin-right: 6px; }

.footnote { font-size: 13px; color: #7a828a; margin-top: 24px; }
.footer { display: flex; align-items: center; padding: 10px 24px; background-color: #0d0e0f; border-top: 1px #26292c; flex-shrink: 0; }
#settings-status { flex-grow: 1; min-width: 0; font-size: 13px; color: #7a828a; margin-right: 12px; }
.close-button { color: #0d0e0f; background-color: #828c96; border-color: #828c96; flex-shrink: 0; }
.close-button:hover { background-color: #9aa4ae; }
scrollbarvertical { width: 8px; }
scrollbarvertical slidertrack { background-color: transparent; }
scrollbarvertical sliderbar { width: 6px; min-height: 24px; background-color: #343a3f; border-radius: 3px; }
scrollbarvertical sliderbar:hover { background-color: #5a626a; }
@media (max-height: 500px) {
        .sidebar { padding: 6px 0; }
    .sidebar button { padding: 7px 16px; font-size: 14px; }
    .content { padding: 12px 20px; }
    .row { min-height: 34px; }
    h3 { margin-top: 16px; }
}
