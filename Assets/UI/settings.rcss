body { margin: 0; width: 100%; height: 100%; background-color: #0d141e; color: #e4edf5; font-family: Bms UI; font-size: 16px; }
div, h1, h2, h3 { display: block; }
h1, h2, h3 { margin: 0; font-weight: normal; }
h1 { font-size: 28px; margin-top: 5px; }
h2 { font-size: 24px; margin-bottom: 10px; }
h3 { font-size: 18px; margin-bottom: 10px; }
#settings-shell { display: flex; flex-direction: column; width: 100%; height: 100%; }
.header { padding: 22px 28px 18px; flex-shrink: 0; border-bottom: 1px #253246; }
.eyebrow { color: #73d5f0; font-size: 12px; }
.workspace { display: flex; flex-grow: 1; flex-shrink: 1; flex-basis: 0px; height: 0px; min-height: 0; overflow: hidden; }
.sidebar { width: 154px; height: 100%; box-sizing: border-box; padding: 20px 12px; background-color: #101a27; flex-shrink: 0; overflow-y: auto; }
button { display: block; box-sizing: border-box; tab-index: auto; color: #c1d2e4; background-color: #172332; border: 1px #2a3c50; border-radius: 7px; padding: 11px 14px; font-size: 15px; }
button:hover { background-color: #243b50; color: white; }
button:focus { border-color: #8be4ff; }
.sidebar button { width: 100%; text-align: left; margin-bottom: 8px; }
.sidebar .active { border-left: 3px #77dcf5; background-color: #1b374b; color: white; }
.content { flex-grow: 1; min-width: 0; height: 100%; box-sizing: border-box; padding: 24px; overflow-y: auto; }
.form-row { margin-bottom: 20px; }
.form-row label { display: block; margin-bottom: 8px; line-height: 1.5; }
.check-row { display: flex; align-items: center; justify-content: space-between; }
.range-row { display: flex; align-items: center; }
.range-value { width: 84px; text-align: right; flex-shrink: 0; color: #8be4ff; }
.card button { margin-top: 8px; }
input[type=range] { display: block; height: 30px; flex-grow: 1; min-width: 0; }
input[type=range] slidertrack { height: 6px; margin-top: 12px; background-color: #334c63; }
input[type=range] sliderbar { width: 16px; height: 26px; background-color: #7bdef5; border-radius: 4px; }
input[type=range]:disabled { opacity: 0.4; }
select:disabled, input[type=checkbox]:disabled, button:disabled { opacity: 0.4; }
select { display: block; box-sizing: border-box; width: 100%; height: 40px; padding: 8px; background-color: #203448; color: #e4edf5; border: 1px #547089; tab-index: auto; }
select:focus { border-color: #8be4ff; }
select selectbox { max-height: 180px; overflow-y: auto; background-color: #203448; border: 1px #547089; z-index: 20; }
select option { display: block; padding: 8px; }
select option:hover, select option:checked { background-color: #365b74; }
.description { font-size: 14px; line-height: 1.6; color: #9cafc3; }
.card { margin-top: 20px; padding: 20px; border: 1px #2a3b4d; background-color: #152231; border-radius: 10px; }
.card-row { display: flex; align-items: center; justify-content: space-between; }
.setting-copy { flex-grow: 1; min-width: 0; margin-right: 18px; }
.toggle { flex-shrink: 0; width: 48px; text-align: center; }
input[type=checkbox] { width: 26px; height: 26px; border: 2px #6a819a; background-color: #263647; border-radius: 7px; }
input[type=checkbox]:checked { background-color: #6cd9f5; border-color: #b6f0ff; }
input[type=checkbox]:focus { border-color: white; }
#resource-state { font-size: 13px; color: #9dcde0; margin-top: 8px; }
.secondary { background-color: #111e2b; }
.secondary-button { margin-top: 16px; }
.footnote { font-size: 13px; color: #849bb1; margin-top: 20px; }
.footer { display: flex; align-items: center; padding: 14px 20px; border-top: 1px #253246; flex-shrink: 0; }
#settings-status { flex-grow: 1; min-width: 0; font-size: 12px; color: #9cb1c5; margin-right: 12px; }
.text-button { font-size: 12px; background-color: transparent; margin-right: 12px; padding: 10px; flex-shrink: 0; }
.close-button { color: #071923; background-color: #7bdef5; flex-shrink: 0; }
.close-button:hover { background-color: #b3efff; color: #071923; }
scrollbarvertical { width: 9px; }
scrollbarvertical slidertrack { background-color: #172332; }
scrollbarvertical sliderbar { width: 7px; min-height: 24px; background-color: #4a718a; border-radius: 3px; }
@media (max-height: 500px) {
    .header { padding: 12px 24px; }
    h1 { font-size: 24px; }
    .sidebar { padding: 12px 8px; }
    .sidebar button { padding: 7px 10px; margin-bottom: 5px; font-size: 14px; }
    .content { padding: 16px; }
}
.skin-path { font-size: 14px; color: #a7bbcf; word-break: break-all; white-space: normal; margin-bottom: 12px; }
