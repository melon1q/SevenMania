/* SevenMania key config screen: black, key modes on the left like the skin select screen, and one row
   per lane with its keyboard key and controller button in red. Click a red text, then press the key or
   button to map. Rows are filled and shown by KeyConfigScreen.inl. */
head, title, link, style, script { display: none; }
body { margin: 0; width: 100%; height: 100%; background-color: #000000; color: #e8e8e5; font-family: Bms UI; font-size: 16px; }
div { display: block; }
#shell { display: flex; flex-direction: row; width: 100%; height: 100%; }
#modes { width: 23%; padding-top: 4%; }
#title { height: 40px; line-height: 40px; padding-left: 14px; font-size: 20px; white-space: nowrap; overflow: hidden; letter-spacing: 2px; color: #ffffff; margin-bottom: 12px; }
.mode { height: 32px; line-height: 32px; padding-left: 14px; margin-bottom: 2px; font-size: 19px; letter-spacing: 1px; white-space: nowrap; overflow: hidden;
        background-color: #3a4a78; color: #b8d4e8; border-bottom: 2px #24305a; cursor: pointer; }
.mode:hover { background-color: #4a5c90; }
.mode.selected { background-color: #3e6f72; color: #ffffff; }
#main { flex: 1; padding: 4% 4% 0 6%; display: flex; flex-direction: column; }
#heading { display: flex; flex-direction: row; height: 30px; line-height: 30px; font-size: 14px; color: #7a828a; letter-spacing: 1px; border-bottom: 1px #333333; margin-bottom: 6px; }
#slots { flex: 1; overflow-y: auto; padding-right: 10px; }
scrollbarvertical { width: 10px; }
scrollbarvertical slidertrack { background-color: #141414; }
scrollbarvertical sliderbar { width: 8px; min-height: 24px; background-color: #5a626a; border-radius: 3px; }
.slot { height: 36px; margin-bottom: 2px; }
.slot-line { display: flex; flex-direction: row; align-items: center; height: 100%; }
.slot.focused .slot-line { background-color: #1a1a1a; }
.slot-label { width: 30%; padding-left: 10px; white-space: nowrap; overflow: hidden; font-size: 17px; }
.column { flex: 1; text-align: center; }
.key { flex: 1; height: 30px; line-height: 30px; text-align: center; font-size: 18px; color: #ff3c3c; white-space: nowrap; overflow: hidden; cursor: pointer; margin: 0 4px; }
.key:hover { background-color: #2a1414; }
.key.unset { color: #6a2a2a; }
.key.listening { background-color: #5a1010; color: #ffffff; }
#device { height: 26px; line-height: 26px; font-size: 13px; color: #8a929a; padding-left: 10px; }
#footer { height: 30px; line-height: 30px; font-size: 13px; color: #7a828a; text-align: right; padding-right: 16px; white-space: nowrap; overflow: hidden; }
#status { color: #c8a060; }
