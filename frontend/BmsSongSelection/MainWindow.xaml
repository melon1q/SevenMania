<Window x:Class="BmsSongSelection.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BMS Player · Song Select" Width="1440" Height="900"
        MinWidth="1120" MinHeight="700" WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="58" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="BMS PLAYER" Foreground="{StaticResource AccentBrush}"
                           FontSize="12" FontWeight="Bold" />
                <TextBlock Text="MUSIC SELECT" FontSize="26" FontWeight="SemiBold" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock Text="{Binding PlayerExecutableLabel}" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Right" FontSize="12" />
                <TextBlock Text="{Binding LibraryRoot}" Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Right" FontSize="13" Margin="0,5,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="플레이어 지정" Click="ChoosePlayer_Click" Margin="0,0,8,0" />
            <Button Grid.Column="1" Content="곡 폴더 열기" Click="ChooseFolder_Click" Margin="0,0,8,0"
                    Background="#183449" BorderBrush="#2A7598" />
            <Button Grid.Column="2" Content="취소" Command="{Binding CancelLoadCommand}" Margin="0,0,14,0"
                    Visibility="{Binding LoadingVisibility}" />
            <TextBox Grid.Column="3" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=160}"
                     VerticalContentAlignment="Center" ToolTip="곡명, 아티스트, 난이도 검색"
                     AutomationProperties.Name="곡 검색" />
            <Button Grid.Column="4" Content="{Binding HiddenToggleLabel}" Command="{Binding ToggleHiddenCommand}"
                    Margin="12,0,8,0" />
            <Button Grid.Column="5" Content="{Binding SortLabel}" Command="{Binding ToggleSortCommand}"
                    MinWidth="72" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="3,0,3,10">
                        <TextBlock Text="곡 목록" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding VisibleGroupCount, StringFormat='{}{0:N0} GROUPS'}"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListView Grid.Row="1" ItemsSource="{Binding GroupsView}"
                              SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                              Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.IsDeferredScrollingEnabled="True">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="Row" Background="#111A26" BorderBrush="#111A26"
                                                    BorderThickness="1" CornerRadius="9" Padding="12,10">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#19364A" />
                                                    <Setter TargetName="Row" Property="BorderBrush" Value="#2D8AB0" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="BorderBrush" Value="#37536A" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Artist}" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding ModeLabel}" Foreground="#A8C9DD" FontSize="11" />
                                            <TextBlock Text="  ·  " Foreground="#526579" FontSize="11" />
                                            <TextBlock Text="{Binding SelectedChart.PlayLevel, TargetNullValue=—}"
                                                       Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                                            <TextBlock Text="  ·  " Foreground="#526579" FontSize="11" />
                                            <TextBlock Text="{Binding Charts.Count, StringFormat='{}{0} charts'}"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#1E2A37" CornerRadius="10"
                                            Padding="9,5" VerticalAlignment="Top" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding SelectedChart.PlayLevel, TargetNullValue=—}"
                                                   Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="26">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="SELECTED TRACK" Foreground="{StaticResource AccentBrush}"
                                   FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="{Binding SelectedGroup.Title, TargetNullValue='곡을 선택하세요'}"
                                   FontSize="27" FontWeight="SemiBold" Margin="0,11,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedChart.Subtitle}" Foreground="#B4C6D8"
                                   FontSize="14" Margin="0,7,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedGroup.Artist}" Foreground="{StaticResource MutedBrush}"
                                   FontSize="13" Margin="0,5,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource PanelRaisedBrush}" CornerRadius="10"
                            Padding="14" Margin="0,24,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="MODE" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                <TextBlock Text="{Binding SelectedChart.ModeLabel, TargetNullValue=—}"
                                           FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="LEVEL" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                <TextBlock Text="{Binding SelectedChart.PlayLevel, TargetNullValue=—}"
                                           Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="Bold" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="BPM · LENGTH" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                <TextBlock Text="{Binding SelectedBpm, StringFormat='{}{0} BPM'}"
                                           FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0" />
                                <TextBlock Text="{Binding SelectedDuration}" Foreground="{StaticResource MutedBrush}"
                                           FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,22,0,0">
                        <TextBlock Text="DIFFICULTY" Foreground="{StaticResource MutedBrush}"
                                   FontSize="10" FontWeight="Bold" />
                        <ComboBox ItemsSource="{Binding SelectedGroup.Charts}"
                                  SelectedItem="{Binding SelectedGroup.SelectedChart, Mode=TwoWay}"
                                  Margin="0,8,0,0" Padding="9,7" Background="#172333" Foreground="#F1F5F9"
                                  BorderBrush="#263649" IsEnabled="{Binding HasSelectedGroup}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding PlayLevel, TargetNullValue=—}" FontWeight="Bold"
                                                   Foreground="#54C7F3" Width="56" />
                                        <TextBlock Text="{Binding Title}" />
                                        <TextBlock Text="{Binding Subtitle}" Foreground="#91A3B8" Margin="8,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,24,0,0">
                        <TextBlock Text="STATUS" Foreground="{StaticResource MutedBrush}"
                                   FontSize="10" FontWeight="Bold" />
                        <Border Background="#101B27" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="9" Padding="13" Margin="0,8,0,0">
                            <TextBlock Text="{Binding SelectedStatus}" TextWrapping="Wrap" FontSize="13" />
                        </Border>
                        <TextBlock Text="{Binding SelectedChart.Genre}" Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" Margin="0,14,0,0" />
                        <TextBlock Text="{Binding SelectedChart.Path}" Foreground="#60758A" FontSize="10"
                                   Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="4" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="C++ 플레이어 연결은 다음 단계에서 추가됩니다."
                                       Foreground="{StaticResource MutedBrush}" FontSize="11" />
                            <TextBlock Foreground="#61758B" FontSize="10" Margin="0,5,0,0">
                                <Run Text="RANDOM seed  " /><Run Text="{Binding SeedLabel}" />
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Content="곡 시작  ›" IsEnabled="False"
                                Background="#1B6A88" BorderBrush="#2D8AB0" Padding="24,12"
                                FontSize="14" FontWeight="SemiBold" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="2,15,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}"
                           FontSize="12" TextTrimming="CharacterEllipsis" />
                <ProgressBar IsIndeterminate="True" Width="110" Height="3" Margin="14,0,0,0"
                             Foreground="{StaticResource AccentBrush}"
                             Visibility="{Binding LoadingVisibility}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="↑ ↓ 곡 선택     ← → 난이도     S 정렬     Enter 재생"
                       Foreground="#71859A" FontSize="11" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
